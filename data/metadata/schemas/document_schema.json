{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Document Metadata Schema",
  "type": "object",
  "required": [
    "doc_id",
    "doc_name", 
    "doc_path",
    "processing_timestamp",
    "total_pages",
    "file_size_bytes",
    "checksum",
    "extraction_methods",
    "processing_status"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "description": "Unique document identifier (typically PDF filename without extension)"
    },
    "doc_name": {
      "type": "string", 
      "description": "Original PDF filename with extension"
    },
    "doc_path": {
      "type": "string",
      "description": "Full path to original PDF file"
    },
    "processing_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of processing"
    },
    "total_pages": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of pages in the document"
    },
    "file_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "File size in bytes"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the PDF file"
    },
    "extraction_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["docling", "layout_parser", "traditional"]
      },
      "uniqueItems": true,
      "description": "List of extraction methods applied to this document"
    },
    "processing_status": {
      "type": "string",
      "enum": ["success", "partial", "failed"],
      "description": "Overall processing status"
    },
    "processing_time_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Total processing time in seconds"
    }
  }
}