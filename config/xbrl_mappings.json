{
    "concept_mappings": {
        "balance_sheet": {
            "patents_and_licensed_technology": {
                "xbrl_concepts": [
                    "us-gaap:PatentsAndLicenses",
                    "us-gaap:PatentsAndLicensesGross",
                    "us-gaap:PatentsAndLicensesAccumulatedAmortization"
                ],
                "description": "Patents and licensed technology, including gross value and accumulated amortization"
            },
            "total_intangible_assets": {
                "xbrl_concepts": [
                    "us-gaap:IntangibleAssetsNetExcludingGoodwill",
                    "us-gaap:IntangibleAssetsGross",
                    "us-gaap:AccumulatedAmortizationIntangibleAssets"
                ],
                "description": "Total intangible assets, including gross value and accumulated amortization"
            }
        },
        "stock_transactions": {
            "shares_repurchased": {
                "xbrl_concepts": [
                    "us-gaap:TreasuryStockSharesAcquired",
                    "us-gaap:StockRepurchasedDuringPeriodShares"
                ],
                "description": "Number of shares repurchased during the period"
            },
            "repurchase_amount": {
                "xbrl_concepts": [
                    "us-gaap:PaymentsForRepurchaseOfCommonStock",
                    "us-gaap:StockRepurchasedDuringPeriodValue"
                ],
                "description": "Amount paid for share repurchases"
            },
            "average_price": {
                "derived": true,
                "calculation": "repurchase_amount / shares_repurchased",
                "description": "Average price per share for repurchases"
            }
        }
    },
    "common_transformations": {
        "monetary_values": {
            "millions_to_ones": {
                "operation": "multiply",
                "factor": 1000000
            }
        },
        "percentages": {
            "decimal_to_percentage": {
                "operation": "multiply",
                "factor": 100
            }
        },
        "dates": {
            "formats": [
                "%Y-%m-%d",
                "%B %d, %Y",
                "%m/%d/%Y"
            ]
        }
    },
    "validation_rules": {
        "tolerance": {
            "absolute_values": 0.01,
            "percentages": 0.0001
        },
        "date_matching": {
            "allow_off_by_one_day": true,
            "handle_fiscal_periods": true
        }
    }
}